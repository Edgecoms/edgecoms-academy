{
  "name": "edgecoms-academy",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next": "^16.3.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "better-auth": "1.7.1",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @edgecoms-academy/db --",
    "db:studio": "turbo run db:studio -F @edgecoms-academy/db --",
    "db:generate": "turbo run db:generate -F @edgecoms-academy/db --",
    "db:migrate": "turbo run db:migrate -F @edgecoms-academy/db --",
    "email:backfill": "DOTENV_CONFIG_PATH=${DOTENV_CONFIG_PATH:-apps/web/.env} bun run packages/auth/scripts/backfill-welcome-emails.ts",
    "db:start": "turbo run db:start -F @edgecoms-academy/db --",
    "db:watch": "turbo run db:watch -F @edgecoms-academy/db --",
    "db:stop": "turbo run db:stop -F @edgecoms-academy/db --",
    "db:down": "turbo run db:down -F @edgecoms-academy/db --",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@edgecoms-academy/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@edgecoms-academy/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "vercel": "^58.1.0"
  },
  "packageManager": "bun@1.3.14"
}

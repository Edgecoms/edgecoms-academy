# Postgres. Local: docker compose in packages/db. Production: Neon pooled connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/edgecoms-academy

# 32 characters minimum. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Public origin. Used for canonical URLs, sitemap, and OG image URLs.
# In production this MUST be the real origin, not the Vercel deployment URL,
# or every canonical points at the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Access code delivery.
# smtp sends to Mailpit at http://localhost:8025. resend sends for real.
# Defaults to smtp outside production, so this can be left unset locally.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Edgecoms Academy <academy@edgecoms.test>
SUPPORT_EMAIL=support@edgecoms.com

# Required only when EMAIL_TRANSPORT is resend.
RESEND_API_KEY=
